# Regenerate the builtin agent-profile index from the rewritten builtins.
post go test ./internal/agentprofile -run TestBuiltinsIndexIsCurrent -update-index
# The User-Agent carries the repo URL (moved); the test matches it as a substring.
rewrite strings.Contains(ua, "github.com/Vulnetix/belai") => strings.Contains(ua, "github.com/Vulnesis/belai")
# Commit trailers are data shared with the website and the vdb-site API (both keep
# them as in Vulnetix); the package and its fixture stay byte-identical.
imports-only internal/attribution/*
# A transferred Pages site keeps its one custom domain (vulnes.is via a proxy):
# belai.vulnetix.com stays the site's real host in CNAME, pages.yml and tests.
keep belai.vulnetix.com
# A slug followed by .git is not rewritten by the slug rule; its test input must
# match the rewritten expectation.
rewrite "vulnetix/vdb-site.git": => "vulnesis/vdb-site.git":

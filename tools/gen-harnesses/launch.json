{
  "claude-code": {
    "tier": "pty", "conf": "H", "bins": ["claude"], "version_args": ["--version"],
    "argv": ["{bin}", "--session-id", "{native_id}"],
    "model_flag": ["--model", "{model}"],
    "modes": {"default": [], "ask": ["--permission-mode", "manual"], "plan": ["--permission-mode", "plan"], "accept_edits": ["--permission-mode", "acceptEdits"]},
    "resume_argv": ["{bin}", "--resume", "{native_id}"],
    "native_id": "uuid4",
    "transcript": {"dialect": "jsonl-claude", "path": "~/.claude/projects/{cwd_slug}/{native_id}.jsonl"},
    "mcp": {"how": "flag-file", "flag": "--mcp-config", "dialect": "claude"},
    "hooks": {"how": "flag-file", "flag": "--settings", "dialect": "claude"},
    "input": {"paste": "bracketed", "submit": "enter", "submit_delay_ms": 80, "multiline": "refuse"},
    "dialogs": [{"id": "trust_folder", "title": "Claude Code asks whether you trust this folder",
      "match": ["Yes, I trust this folder", "No, exit"],
      "options": [{"id": "trust", "label": "Trust", "keys": ["down", "enter"]}, {"id": "dont_trust", "label": "Don't trust", "keys": ["esc"]}]},
      {"id": "tool_permission", "title": "Claude Code asks to run a tool",
      "match": ["Do you want to", "1. Yes", "3. No", "Esc to cancel"],
      "options": [{"id": "allow_once", "label": "Allow once", "keys": ["1"]}, {"id": "allow_always", "label": "Allow for this session", "keys": ["2"]}, {"id": "deny", "label": "Deny", "keys": ["esc"]}]}],
    "keys": {"interrupt": "esc", "exit": ["/exit", "enter"], "allow": ["enter", "esc", "up", "down", "tab", "1", "2", "3"]},
    "quiet_ms": 1500,
    "never_flags": ["-p", "--print", "--dangerously-skip-permissions", "--allow-dangerously-skip-permissions", "bypassPermissions", "dontAsk", "--output-format", "--input-format"],
    "grant_env": ["ANTHROPIC_API_KEY"],
    "name_flag": ["--name", "{thread_name}"], "continuity": ["session-id-match"], "caveats": [{"code": "posix_only", "note": "Stop and kill signal the process group; harness sessions run on Linux and macOS only"}, {"code": "trust_dialog_first_run", "note": "A new folder is asked about before the first prompt; the owner answers it as an ask"}, {"code": "resume_may_fork", "note": "Resume can start a copy under a new id; belai refuses that as continuity_unverified"}],
    "source": "host: claude 2.1.330 --help", "min_version": "2.1.330"
  },
  "codex": {
    "tier": "pty", "conf": "H", "bins": ["codex"], "version_args": ["--version"],
    "argv": ["{bin}"],
    "model_flag": ["-m", "{model}"],

    "keys": {"interrupt": "esc", "exit": ["ctrl-c", "ctrl-c"], "allow": ["enter", "esc", "up", "down", "tab", "1", "2", "3", "y", "n"]},
    "quiet_ms": 1500,
    "never_flags": ["exec", "e", "--dangerously-bypass-approvals-and-sandbox", "--yolo", "--full-auto", "--approve-for-me", "danger-full-access", "never", "--dangerously-bypass-hook-trust"],
    "grant_env": ["OPENAI_API_KEY"],
